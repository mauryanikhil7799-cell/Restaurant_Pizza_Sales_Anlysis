/* Creating a database for the Project using DDL Functions */

---Use Drop if the database already exsist---
---This query drop the database Pizza_Sales_SQL_Analysis from the server and set only single user who run the query ----

USE master
GO

IF DB_ID ('Pizza_Sales_SQL_Analysis') IS NOT NULL
	BEGIN 
		ALTER DATABASE Pizza_Sales_SQL_Analysis
		SET SINGLE_USER 
		WITH ROLLBACK IMMEDIATE;
		DROP DATABASE Pizza_Sales_SQL_Analysis
	END
GO

---This query Create the database Pizza_Sales_SQL_Analysis in the server ----

CREATE DATABASE Pizza_Sales_SQL_Analysis;
GO

USE Pizza_Sales_SQL_Analysis
GO


---This query Create the Table in the datbase Pizza_Sales_SQL_Analysis----

--- Creating Order_details table after drop if table exsits---
DROP TABLE IF EXISTS Order_details;

CREATE TABLE Order_details (
					Order_details_id INT,
					Order_id INT,
					Pizza_id VARCHAR(50),
					Quantity INT
)
GO

--- Creating Table Order after drop if table exsits ---
DROP TABLE IF EXISTS Orders;
CREATE TABLE Orders(
					Order_id INT,
					Order_date DATE,
					Order_time TIME
)
GO

--- Creating Table Pizza_types after drop if table exsits ---
DROP TABLE IF EXISTS Pizza_types;
CREATE TABLE Pizza_types(
						Pizza_type_id VARCHAR(50),
						Pizza_Names VARCHAR(50),
						Category VARCHAR(50),
						Ingredients VARCHAR(100)
)
GO

--- Creating Table Pizza after drop if table exsits ---
DROP TABLE IF EXISTS Pizzas;
CREATE TABLE Pizzas(
					Pizza_id VARCHAR(50),
					Pizza_type_id VARCHAR(50),
					Size VARCHAR(50),
					Price Decimal(10,3)
)
GO

